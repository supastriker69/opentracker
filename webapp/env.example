# Copy to .env.production (and .env.staging on the staging machine), fill in, and keep it private.
# ops/deploy.sh reads it; docker compose fails early when a required value is missing.

# --- required ---
SITE_DOMAIN=opentracker.example.org          # the public address; DNS must point at this machine
VAPID_SUBJECT=mailto:alerts@example.org      # a real contact address for the push services

# --- monitoring (docs/RUNBOOK.md → Monitoring) ---
ALERT_NAME=Open Tracker production           # shown at the start of every operator alert
ALERT_WEBHOOK_URL=                           # Slack, Discord, Teams, ntfy … incoming webhook (https)
METRICS_TOKEN=                               # openssl rand -hex 24; your monitoring system sends it to /metrics
LOG_LEVEL=info

# --- backups (docs/RUNBOOK.md → Backups) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_UPLOAD=                               # optional command that copies /backups off this machine

# --- maps and data (webapp/README.md → Settings) ---
MAP_TILES_URL=
MAP_GLYPHS_URL=
TERRAIN_TILES_URL=
FEEDS_OFF=
GOOGLE_WEATHER_API_KEY=
WEATHEREX_ENABLED=                           # leave off until WeatherEx agrees

# --- ports (change only when another web server already uses 80 and 443 on this machine) ---
HTTP_PORT=80
HTTPS_PORT=443
