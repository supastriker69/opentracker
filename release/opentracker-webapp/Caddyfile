# SITE_DOMAIN comes from the settings file (.env.production or .env.staging).
# Caddy gets and renews the HTTPS certificate automatically.
# /metrics passes through but answers only with METRICS_TOKEN (docs/RUNBOOK.md → Monitoring).
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8080 {
		lb_policy least_conn
		health_uri /readyz
	}
}
