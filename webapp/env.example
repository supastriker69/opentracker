# Copy to .env.production (and .env.staging on the staging machine), fill in, and keep it private.
# ops/deploy.sh reads it; docker compose stops early when a required value is missing.
# Comments go on their own lines: text after a value would become part of the value.

# --- required ---
# The public address; DNS must point at this machine.
SITE_DOMAIN=opentracker.example.org
# A real contact address for the push services.
VAPID_SUBJECT=mailto:alerts@example.org

# --- monitoring (docs/RUNBOOK.md → Monitoring) ---
# Shown at the start of every operator alert.
ALERT_NAME=Open Tracker production
# Incoming webhook of Slack, Discord, Teams, ntfy … (https).
ALERT_WEBHOOK_URL=
# openssl rand -hex 24; your monitoring system sends it to /metrics.
METRICS_TOKEN=
LOG_LEVEL=info

# --- backups (docs/RUNBOOK.md → Backups) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Optional command that copies /backups off this machine.
BACKUP_UPLOAD=

# --- maps and data (webapp/README.md → Settings) ---
MAP_TILES_URL=
MAP_GLYPHS_URL=
TERRAIN_TILES_URL=
FEEDS_OFF=
GOOGLE_WEATHER_API_KEY=
# Leave off until WeatherEx agrees.
WEATHEREX_ENABLED=

# --- ports (change only when another web server already uses 80 and 443 on this machine) ---
HTTP_PORT=80
HTTPS_PORT=443
